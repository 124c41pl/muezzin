<!--
  WinSW service definition for muezzin. This file is the whole service: WinSW
  renames itself to muezzin-service.exe, sits beside it, and this XML says what
  boots with the machine.

  Why WinSW and not a pywin32 service class: the daemon is a foreground
  process that does not trap SIGTERM (docs/HOW-IT-WORKS.md says so out loud),
  so a service wrapper that speaks the SCM protocol "properly" would be
  pretending to have a graceful stop the program does not have. WinSW's model
  — start a process, restart it when it dies, Kill on uninstall — is the same
  honesty the container entrypoint already keeps, and start-on-boot, recovery
  and event-log integration come free. Revisit only if we ever add a real
  shutdown handler to the daemon.

  Everything paths-related points at %ProgramData%\muezzin, not at the install
  folder, because the exe is disposable and the profile is not: an upgrade
  replaces the exe next to this file and the household's schedule and audio do
  not move. That is the same split as the container's ./config and ./media
  mounts, and it is the decision here that is hardest to change later, so it
  lives in a comment where the next person can argue with it.

  Making this machine's own speakers play on a schedule is not what this shape
  is for, and that is a decision, not an open question: a service runs in
  Session 0, and the point of hosting muezzin as a service is that the sound
  goes somewhere else — google_cast, lan_box, file. `pc_speakers` stays what it
  has always been, the output you use from a console in your own session.
-->
<service>
  <id>muezzin</id>
  <name>muezzin (adhan daemon)</name>
  <description>Plays the adhan on your own speakers on the times your own calculation says. Page on :8020, media on :8010.</description>

  <!-- The frozen app. Same exe, same arguments as typing it in a console. -->
  <executable>%BASE%\muezzin.exe</executable>
  <arguments>daemon -c "%ProgramData%\muezzin\muezzin.yaml" --web</arguments>

  <!-- Where relative things land if the profile leaves them relative: tiles
       live beside the profile by design, out_dir is the one a kind: file
       output may write. Pinning cwd means a stray relative path goes under
       ProgramData, not under System32, which is what the service defaults to.
       The %ProgramData% here is expanded by WinSW, not by cmd.exe: the v2.12
       config docs say a config file may contain environment-variable
       expansions of the form %Name%, and BASE is one it sets by itself - which
       is why %BASE% names the exe's folder and nothing else does. An
       undefined name is left alone rather than replaced by an empty string. -->
  <workingdirectory>%ProgramData%\muezzin</workingdirectory>

  <!-- The environment is the second way to name a port, exactly as in the
       image (README, "Ports"): the bare web flag on the arguments line above
       means these have something to fill in, and a number typed on the
       command line would still outrank them. -->
  <env name="MUEZZIN_WEB_PORT" value="8020"/>
  <env name="MUEZZIN_HTTP_PORT" value="8010"/>

  <!-- No TZ line. The profile already names the zone the times are computed
       for, and TZ only ever moves the defaults a process starts with: pinning
       one city in a file that ships to every household would be wrong for
       every household but one. Left unset, the service inherits the machine's
       zone, which is what a console run does. -->
  <startmode>Automatic</startmode>

  <!-- The daemon is meant to be forever: a prayer it misses is a prayer
       nobody hears. Restart it, and if it dies in a loop, back off rather
       than spam the event log.

       Spelling matters here and it was checked against the version this repo
       pins: WinSW 2.12 documents the failure actions as repeatable
       <onfailure action=... delay=.../> elements, and its own binary carries
       that word (the string was searched for, not assumed). A <failure>
       element with nested <action>/<delay> belongs to the v3 config format.
       Beyond the two actions listed, Windows repeats the last one - that is
       why the 60-second back-off is the one written twice in effect. -->
  <resetfailure>1 hour</resetfailure>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="60 sec"/>

  <!-- WinSW's own log rotation; stdout/stderr of the daemon land here, which
       is the console output you would have watched by hand. -->
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>

  <!-- End the process tree rather than send it a signal it does not read; the
       daemon has no shutdown handler, which is the whole reason for a wrapper
       with a Kill model. Kept, but not relied on: in the one sequence where it
       mattered — an uninstall on the first machine this shipped to — the wrapper
       logged the stop action and its `WaitForProcessToExit` line, and the
       process was still there seventeen minutes later. Nothing in any log here
       confirms that this pair ended anything, so the installer waits for the
       process and ends it itself instead of assuming this line did the work. -->
  <stopexecutable>taskkill.exe</stopexecutable>
  <stoparguments>/PID {PID} /T /F</stoparguments>
</service>
