# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# runtime leftovers
out/
# the map squares this daemon fetched for one household's page. Deleting the folder is
# safe - the squares are just fetched again - and a cache of one family's neighbourhood
# has no business riding along in anyone's commit.
muezzin-tiles/
media/*
!media/README.md
# two short tones generated for testing, not recordings of anyone's voice or
# recitation. They are checked in on purpose: the README walks a first-time user
# through "play this and listen", and a clone without them cannot follow it.
!media/test-tone.wav
!media/test-chime.wav

# personal configs: these name real speakers and real IPs on someone's LAN
muezzin.yaml
_livecast.yaml
_box.yaml
_smoke.yaml

# the old name, in case a config file still carries it
azankit.yaml

# Private working material, in two places: notes/ is what the developer wrote down,
# research/ is the throwaway probe scripts and measurements that answered a question
# during the work, plus anything gathered while reading another program's installer.
# Probe scripts are the record of how a number was checked, and they are worth keeping
# on the machine that did the checking - but they are not the program, they are not
# run by any test, and the installer material is someone else's proprietary work. So
# both folders stay in a working copy: never in this repository, never in a built image.
notes/
research/
*.exe
extracted/
extracted2/
issdir/
tools/
