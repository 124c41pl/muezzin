# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# runtime leftovers
out/
# the map squares this daemon fetched for one household's page. Deleting the folder is
# safe - the squares are just fetched again - and a cache of one family's neighbourhood
# has no business riding along in anyone's commit.
muezzin-tiles/
media/*
!media/README.md
# two short tones generated for testing, not recordings of anyone's voice or
# recitation. They are checked in on purpose: the README walks a first-time user
# through "play this and listen", and a clone without them cannot follow it.
!media/test-tone.wav
!media/test-chime.wav

# personal configs: these name real speakers and real IPs on someone's LAN
muezzin.yaml
_livecast.yaml
_box.yaml
_smoke.yaml

# the old name, in case a config file still carries it
azankit.yaml

# private working notes, and the material someone gathered while reading another
# program's installer. That material is someone else's proprietary work: it stays
# in a working copy, never in this repository, and never in a built image.
notes/
*.exe
extracted/
extracted2/
issdir/
tools/
research/logs/
research/installer_script.txt
