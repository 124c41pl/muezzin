# What the image does not need: version control, the virtualenv, the tests, and
# the private notes and working material in this directory. None of that is
# muezzin's to ship — the notes and unpacked binaries describe someone else's
# proprietary program, and an image carrying a binary someone else owns is not
# MIT's to redistribute.
.git/
.gitignore
.venv/
out/
research/
notes/
tests/
tools/
extracted/
extracted2/
issdir/
*.exe
FINDINGS.md
__pycache__/
*.pyc
.pytest_cache_/
docker-compose.yml
Dockerfile
.dockerignore

# Your profile and your audio are mounted at run time. Baking them in would put
# your house, your speakers and your schedule inside a redistributable image.
*.yaml
media/
